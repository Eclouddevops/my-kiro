# ---- Backend configuration (copy to backend/.env) ----

# App
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Security / auth
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://ide:ide@localhost:5432/ide

# Storage backend: fs (local disk, dev) or s3
STORAGE_BACKEND=fs
PROJECTS_DIR=./_projects
# Only used when STORAGE_BACKEND=s3
S3_BUCKET=
S3_PREFIX=projects/

# AWS / Amazon Bedrock (backend only — NEVER expose to the frontend)
AWS_REGION=us-east-1
# Credentials are resolved by the default AWS provider chain (env, profile,
# IAM role). For local dev you may set these explicitly:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
CONTEXT_TOKEN_BUDGET=12000

# Code execution sandbox
EXEC_IMAGE=python:3.11-slim
EXEC_TIMEOUT_SECONDS=30
EXEC_MEMORY_LIMIT=256m
EXEC_CPU_LIMIT=0.5
EXEC_PIDS_LIMIT=128
