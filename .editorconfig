# EditorConfig keeps line endings and indentation consistent across macOS,
# Linux, and Windows. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,md}]
indent_size = 4

[Makefile]
indent_style = tab

[*.sh]
end_of_line = lf
